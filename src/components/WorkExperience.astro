---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";

const allExperiences = await getCollection("experience");
allExperiences.sort((a, b) => a.data.order - b.data.order);

const professionalExperiences = allExperiences.filter(exp => exp.data.type === "professional");
const otherExperiences = allExperiences.filter(exp => exp.data.type !== "professional");
---
<section id="experience" class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-12 flex items-center">
      <span class="w-8 h-1 bg-primary mr-4 rounded-full"></span>
      Work Experience
    </h2>

    <div class="space-y-16">
      <div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-8 ml-4 sm:ml-0 sm:text-center flex items-center sm:justify-center gap-3">
          <Icon name="fa6-solid:briefcase" class="w-6 h-6 text-primary" />
          Professional Experience
        </h3>
        <div class="relative">
          {professionalExperiences.map(async (exp, index) => {
            const { Content } = await render(exp);
            const isEven = index % 2 === 0;
            return (
              <div class="relative pl-8 sm:pl-0 pb-8 last:pb-0">
                <div class="hidden sm:block absolute left-1/2 -ml-px w-0.5 h-full bg-slate-200 dark:bg-slate-700 z-0"></div>
                <div class={`sm:flex items-center justify-between w-full ${isEven ? "flex-row-reverse" : ""}`}>
                  <div class="hidden sm:block sm:w-5/12"></div>
                  <div class="absolute left-0 sm:left-1/2 w-4 h-4 rounded-full bg-primary border-4 border-white dark:border-slate-900 -ml-2 mt-2 sm:mt-0 z-10 shadow-sm"></div>
                  <div class={`w-full sm:w-5/12 ${isEven ? "sm:text-right" : "sm:text-left"}`}>
                     <div class="bg-white dark:bg-slate-800 p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow duration-300">
                        <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full mb-4">{exp.data.duration}</span>
                        <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-1">{exp.data.title}</h4>
                        <p class="text-lg text-slate-700 dark:text-slate-300 font-medium mb-1">{exp.data.company}</p>
                        {exp.data.location && <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">{exp.data.location}</p>}
                        <div class="prose prose-sm dark:prose-invert max-w-none text-slate-600 dark:text-slate-400 prose-li:my-1 text-left sm:text-left">
                          <Content />
                        </div>
                     </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {otherExperiences.length > 0 && (
        <div class="pt-8">
          <h3 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-8 ml-4 sm:ml-0 sm:text-center flex items-center sm:justify-center gap-3">
            <Icon name="fa6-solid:calendar-days" class="w-6 h-6 text-slate-500" />
            Other Experience
          </h3>
          <div class="relative">
            {otherExperiences.map(async (exp, index) => {
              const { Content } = await render(exp);
              const isEven = (professionalExperiences.length + index) % 2 === 0;
              return (
                <div class="relative pl-8 sm:pl-0 pb-8 last:pb-0">
                  <div class="hidden sm:block absolute left-1/2 -ml-px w-0.5 h-full bg-slate-200 dark:bg-slate-700 z-0"></div>
                  <div class={`sm:flex items-center justify-between w-full ${isEven ? "flex-row-reverse" : ""}`}>
                    <div class="hidden sm:block sm:w-5/12"></div>
                    <div class="absolute left-0 sm:left-1/2 w-4 h-4 rounded-full bg-slate-400 dark:bg-slate-500 border-4 border-white dark:border-slate-900 -ml-2 mt-2 sm:mt-0 z-10 shadow-sm"></div>
                    <div class={`w-full sm:w-5/12 ${isEven ? "sm:text-right" : "sm:text-left"}`}>
                       <div class="bg-white dark:bg-slate-800 p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow duration-300">
                          <span class="inline-block px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold rounded-full mb-4">{exp.data.duration}</span>
                          <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-1">{exp.data.title}</h4>
                          <p class="text-lg text-slate-700 dark:text-slate-300 font-medium mb-1">{exp.data.company}</p>
                          {exp.data.location && <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">{exp.data.location}</p>}
                          <div class="prose prose-sm dark:prose-invert max-w-none text-slate-600 dark:text-slate-400 prose-li:my-1 text-left sm:text-left">
                            <Content />
                          </div>
                       </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
