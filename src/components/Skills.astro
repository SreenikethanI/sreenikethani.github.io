---
import { getCollection } from 'astro:content';

const skills = (await getCollection("skills")).map(file => file.data);

// Sort sections by order
skills.sort((a, b) => a.order - b.order);
---

<section id="skills" class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    {
      skills.map(section => (
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-12 flex items-center">
            <span class="w-8 h-1 bg-primary mr-4 rounded-full"></span>
            {section.title}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {section.categories.map(category => (
              <div class="bg-white dark:bg-slate-800 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-100 dark:border-slate-700 pb-3">{category.name}</h3>
                <div class="flex flex-wrap gap-2">
                  {category.skills.map(skill => (
                    <span class="px-4 py-2 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }

  </div>
</section>
