---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const educationList = await getCollection("education");
educationList.sort((a, b) => a.data.order - b.data.order);
---
<section id="education" class="py-16 bg-slate-100/50 dark:bg-slate-800/30 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-12 flex items-center">
      <span class="w-8 h-1 bg-primary mr-4 rounded-full"></span>
      Education
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {educationList.map((edu) => (
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm p-8 border border-slate-200 dark:border-slate-700 transition-all duration-300 hover:shadow-md hover:border-primary/50 dark:hover:border-primary/50">
          <div class="flex justify-between items-start mb-6">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center">
              <Icon name="fa6-solid:graduation-cap" class="w-6 h-6" />
            </div>
            {edu.data.year && <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full mt-1">{edu.data.year}</span>}
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{edu.data.degree}</h3>
          <p class="text-lg text-primary font-medium mb-2">{edu.data.institution}</p>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-semibold mb-4">{edu.data.duration}</p>
          {edu.data.details && edu.data.details.length > 0 && (
            <ul class="list-disc list-inside text-slate-600 dark:text-slate-400 text-sm space-y-1 mt-4">
              {edu.data.details.map((detail: string) => (
                <li>{detail}</li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
