---
import { Icon } from "astro-icon/components";
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 dark:bg-slate-900 border-t border-border-light dark:border-border-dark py-12 transition-colors duration-300 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
    <div class="flex space-x-6 mb-6">
      <a href="mailto:sreeni.s.iyer@gmail.com" class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-colors">
        <span class="sr-only">Email</span>
        <Icon name="fa6-solid:envelope" class="h-6 w-6" />
      </a>
      <a href="https://github.com/SreenikethanI" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-colors">
        <span class="sr-only">GitHub</span>
        <Icon name="fa6-brands:github" class="h-6 w-6" />
      </a>
      <a href="https://linkedin.com/in/sreenikethan-i" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary transition-colors">
        <span class="sr-only">LinkedIn</span>
        <Icon name="fa6-brands:linkedin" class="h-6 w-6" />
      </a>
    </div>
    <p class="text-slate-600 dark:text-slate-400 text-sm">&copy; {currentYear} Sreenikethan Iyer. All rights reserved.</p>
    <p class="mt-2 text-slate-600 dark:text-slate-400 text-sm">Theme inspired by <a href="https://github.com/morhetz/gruvbox" target="_blank" class="hover:text-primary dark:hover:text-primary transition-colors">Gruvbox</a>.</p>
  </div>
</footer>
